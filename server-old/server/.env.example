PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/student_management?replicaSet=rs0
# Generate a fresh secret before starting: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Must be at least 1000 ms and no longer than JWT_EXPIRES_IN.
JWT_COOKIE_MAX_AGE_MS=3600000
# Development origins only. Set every production browser origin to its exact HTTPS URL.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Must use an origin listed in CLIENT_ORIGINS; used to build student invitation and password reset links.
CLIENT_APP_URL=http://localhost:5173/
# Optional SMTP delivery; leave the whole block empty to use the admin copy-link fallback locally.
SMTP_HOST=
SMTP_PORT=587
# Port 465 normally uses implicit TLS; port 587 uses STARTTLS.
# Leave blank to infer from SMTP_PORT (465 = true, other ports = false).
SMTP_SECURE=
SMTP_REQUIRE_TLS=true
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
# Required with SMTP. Generate separately and store in the deployment secret manager.
# Generate with: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
EMAIL_OUTBOX_ENCRYPTION_KEY=
# MongoDB server-selection timeout; accepted range is 1000–120000 ms.
DB_CONNECT_TIMEOUT_MS=10000
TRUST_PROXY_HOPS=0
# Destination for encrypted logical backups; use separate secure storage in production.
BACKUP_DIR=./backups
# Set a generated 32-byte base64 key; keep it in a secrets manager, separate from backup files.
# Generate with: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=
