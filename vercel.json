{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client-old/client",
      "framework": "vite"
    },
    "server": {
      "root": "server-old/server",
      "framework": "express",
      "entrypoint": "index.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}
